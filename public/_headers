# Applies to files served by Workers Static Assets (not worker responses).
# Hashed assets never change, so browsers cache them forever: navigating
# between pages only fetches the new HTML.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/images/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/favicon.svg
  Cache-Control: public, max-age=86400

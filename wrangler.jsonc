{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandermorgan",
  // Built by scripts/build.ts, which wrangler runs itself before dev and deploy
  // (and again on changes in watch_dir); the result is uploaded as-is.
  "main": "dist/worker.js",
  "build": {
    "command": "bun scripts/build.ts",
    "watch_dir": ["src", "pages", "client", "styles", "vendor", "public"]
  },
  "no_bundle": true,
  "find_additional_modules": false,
  "compatibility_date": "2026-09-20",
  // Served only on the custom domain; www redirects to it (see worker.ts).
  // The domain must be on this Cloudflare account before the first deploy.
  "routes": [
    { "pattern": "alexandermorgan.dev", "custom_domain": true },
    { "pattern": "www.alexandermorgan.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    // Files are served at exactly their own paths: the worker reads
    // /_pages/projects.html itself, and no URL maps to a .html file on its own.
    "html_handling": "none",
    // Static files are served before the worker runs, except the page files,
    // which only the worker may read (it answers /_pages/* with a 404).
    "run_worker_first": ["/_pages/*"]
  }
}
